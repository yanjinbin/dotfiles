[meta]
name = "One Dark Unified"
mode = "dark"

[terminal]
cursor = "#61AFEF"
cursor-text = "#282C34"
selection-foreground = "#E6EAF0"
selection-background = "#3E4B61"
foreground = "#ABB2BF"
background = "#282C34"
palette = [
    "#1E2127", "#E06C75", "#98C379", "#D19A66",
    "#61AFEF", "#C678DD", "#56B6C2", "#ABB2BF",
    "#5C6370", "#E06C75", "#98C379", "#D19A66",
    "#61AFEF", "#C678DD", "#56B6C2", "#FFFFFF",
]

[token]
foreground = "#ABB2BF"
secondary = "#9AA3B2"
tertiary = "#788392"
accent = "#61AFEF"

[panel]
background = "#282C34"
surface = "#2C313A"
border = "#3B424F"

[sidebar]
background = "#21252B"
border-right = "1px solid #3B424F"
material = "none"

[tab]
foreground = "#9AA3B2"

[tab.active]
background = "#323C4D"
foreground = "#E6EAF0"
font-weight = 600

[tab.hover]
background = "#2C313A"

[titlebar]
background = "#21252B"
