        "id": "open",
        "title": "Open bar",
        "description": "Fuzzy-jump to any tab, pane, or agent",
        "contexts": [
          "global"
        ],
        "command": [
          "sh",
          "-c",
          "herdr_bin=\"${HERDR_BIN_PATH:-herdr}\"; [ -x \"$herdr_bin\" ] || herdr_bin=herdr; exec \"$herdr_bin\" plugin pane open --plugin herdr-bar --entrypoint bar --placement popup"
        ]
      },
      {
        "id": "start-titles",
        "title": "Start automatic tab titles",
        "description": "Keep Claude and Codex task titles updated while the bar is closed",
        "contexts": [
          "global"
        ],
        "command": [
          "python3",
          "run.py",
          "--start-titles",
          "--resume"
        ]
      },
      {
        "id": "stop-titles",
        "title": "Stop automatic tab titles",
        "description": "Stop this server's title watcher until explicitly started again",
        "contexts": [
          "global"
        ],
        "command": [
          "python3",
          "run.py",
          "--stop-titles"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": [
          "python3",
          "run.py",
          "--start-titles"
        ]
      }
    ],
    "panes": [
      {
        "id": "bar",
        "title": "Bar",
        "description": "Fuzzy-jump to any tab, pane, or agent",
        "placement": "popup",
        "width": "74%",
        "height": "62%",
        "command": [
          "python3",
          "run.py"
        ]
      }
    ],
    "source": {
      "kind": "github",
