[
  {
    "plugin_id": "herdr-agent-usage",
    "name": "Herdr Agent Usage",
    "version": "1.6.3",
    "min_herdr_version": "0.9.0",
    "description": "Credential-scoped AI quota and context for Claude, Codex, Grok, Agy, OpenCode, Pi, omp, Devin, Muse, and Cursor.",
    "manifest_path": "/Users/yanjinbin/WebstormProjects/herdr-agent-usage/herdr-plugin.toml",
    "plugin_root": "/Users/yanjinbin/WebstormProjects/herdr-agent-usage",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "build": [
      {
        "command": [
          "cargo",
          "build",
          "--release"
        ]
      }
    ],
    "startup": [
      {
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" startup --provider all"
        ]
      }
    ],
    "actions": [
      {
        "id": "configure",
        "title": "Install / repair agent quota",
        "command": [
          "sh",
          "-c",
          "\"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" configure --apply && herdr server reload-config && exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" startup --provider all"
        ]
      },
      {
        "id": "open-settings",
        "title": "Open agent quota settings",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_BIN_PATH\" plugin pane open --plugin herdr-agent-usage --entrypoint settings --focus"
        ]
      },
      {
        "id": "refresh",
        "title": "Refresh agent quota",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" refresh --provider all --force"
        ]
      },
      {
        "id": "uninstall",
        "title": "Uninstall agent quota configuration",
        "command": [
          "sh",
          "-c",
          "\"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" configure --uninstall && herdr server reload-config"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" event"
        ]
      },
      {
        "on": "pane.agent_status_changed",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" event"
        ]
      },
      {
        "on": "pane.focused",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" focus"
        ]
      },
      {
        "on": "tab.focused",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" focus"
        ]
      },
      {
        "on": "workspace.focused",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" focus"
        ]
      }
    ],
    "panes": [
      {
        "id": "dashboard",
        "title": "Agent quota",
        "placement": "popup",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" dashboard"
        ]
      },
      {
        "id": "settings",
        "title": "Agent quota settings",
        "placement": "popup",
        "width": 78,
        "height": 37,
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-usage\" settings"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  },
  {
    "plugin_id": "herdr-bar",
    "name": "Bar",
    "version": "0.5.1",
    "min_herdr_version": "0.9.0",
    "description": "Cmd+K command bar with auto title: automatic tab titles, agent icons, and fuzzy search",
    "manifest_path": "/Users/yanjinbin/.config/herdr/plugins/github/herdr-bar-96eebe452a9c/herdr-plugin.toml",
    "plugin_root": "/Users/yanjinbin/.config/herdr/plugins/github/herdr-bar-96eebe452a9c",
